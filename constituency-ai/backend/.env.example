GCP_PROJECT_ID=constituency-ai-2026
GCP_LOCATION=asia-south1
GCS_BUCKET=constituency-ai-2026-uploads
BQ_DATASET=constituency
GEMINI_API_KEY=
MAPS_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
DISTRICT_NAME=Anantapur, Andhra Pradesh, India
ADMIN_TOKEN=demo
PORT=8080
# USE_MOCKS is a global override that always wins (demo-day safety net). Below that,
# each AI/ML stage has its own flag. STT/Translate/Geocode all work today, so they
# default to live (false). Gemini extraction + embeddings share one blocked billing
# surface, so they default to mocked (true) until that's resolved.
USE_MOCKS=false
MOCK_STT=false
MOCK_TRANSLATE=false
MOCK_GEOCODE=false
MOCK_GEMINI=true

# WhatsApp intake via Twilio sandbox (see infra/gcp_setup.md or README for setup steps)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public HTTPS URL Twilio can reach, no trailing slash (ngrok URL for local dev, or
# the Cloud Run URL for the live demo). Required for signature validation.
PUBLIC_BASE_URL=
# Dev-only escape hatch - never set to false for the live demo.
TWILIO_VALIDATE_SIGNATURE=true
